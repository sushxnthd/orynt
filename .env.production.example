DATABASE_URL=postgres://orynt:CHANGE_ME@postgres:5432/orynt
SESSION_SECRET=replace-with-at-least-32-random-characters
ORYNT_DOMAIN=orynt.example.com
POSTGRES_PASSWORD=replace-me
# Optional provider-assisted AIP (OpenAI-compatible endpoint)
AIP_PROVIDER_URL=
AIP_API_KEY=
AIP_MODEL=
# Optional outbound connector host allowlist, comma separated
CONNECTOR_HOST_ALLOWLIST=
# Connector secrets are referenced by env-var name from Orynt Connect
FEDENA_TOKEN=
